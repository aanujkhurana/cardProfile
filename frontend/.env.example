# Server-only — never prefix with VITE_.
# Set in your Vercel project settings (or local .env for `vercel dev`).
GEMINI_API_KEY=your-google-gemini-api-key

# Optional. Defaults to "gemini-3.7-flash" when unset.
GEMINI_MODEL=gemini-3.7-flash

# Sanity CMS (server-only — the token must never reach the client).
SANITY_PROJECT_ID=your-sanity-project-id
SANITY_TOKEN=your-sanity-api-token

# Public Sanity project id used to build image URLs in the browser.
# NOT secret — it already appears in CDN image URLs.
VITE_SANITY_PROJECT_ID=your-sanity-project-id

# Optional. Set this ONLY when building for a pure-static host (GitHub Pages).
# Points /api/* calls at the Vercel deployment where the serverless functions
# run. Leave empty for local dev and Vercel deploys — relative paths work
# automatically there via Vite proxy or co-located functions.
# VITE_API_BASE=https://frontend-anuj-khuranas-projects.vercel.app

# Optional. Server-side CORS origin allowlist for /api/* serverless functions.
# Defaults to "*" (safe — no cookies/credentials are used). Set to your
# GitHub Pages URL to lock it down.
# CORS_ORIGIN=https://aanujkhurana.github.io
